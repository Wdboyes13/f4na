println("for x in int");
for x in 10 {
    print(x);
    print(" ");
}
println("");

println("for x in array");
for x in {1, 2, 3} {
    print(x);
    print(" ");
}
println("");

println("for (init; cond; mod)");
for (let x = 0; x < 10; x = x + 1) {
    print(x);
    print(" ");
}
println("");

fn is_even(x) {
    ret (x % 2 == 0);
}

println("break test");
for (let x = 0; x < 10; x = x + 1) {
    print(x);
    print(" ");
    if x >= 5 {
        break;
    }
}
println("");

println("continue test");
for x in 10 {
    print(x);
    if is_even(x) {
        continue;
    }
    print(" ");
}
println("");